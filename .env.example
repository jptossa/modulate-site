# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by ingest scripts and guest rate limiting. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Chatbot
ANTHROPIC_API_KEY=
# Default model answers most questions; it can hand a hard one to the escalation model (same value = no escalation).
CHAT_MODEL=claude-haiku-5-5
CHAT_ESCALATION_MODEL=claude-sonnet-5-5
# Escalations per person per day (guest IP or account).
SONNET_DAILY_LIMIT=10
# Daily request budgets (optional). Guests are counted per hashed IP, signed-in users per account.
GUEST_DAILY_LIMIT=20
USER_DAILY_LIMIT=200
# Secret salt for hashing guest IPs. Required in production; any long random string.
RATE_LIMIT_SALT=
